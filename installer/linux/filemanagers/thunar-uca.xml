<!-- Add inside <actions> of ~/.config/Thunar/uca.xml (Thunar > Edit > Configure custom actions),
     or run /usr/share/shield/integrate.sh which does it for the current user. -->
<action>
  <icon>shield</icon>
  <name>Encrypt with Shield</name>
  <unique-id>shield-encrypt-3</unique-id>
  <command>shield-gui --encrypt-multi %F</command>
  <description>One container or one per item (asked)</description>
  <patterns>*</patterns>
  <directories/><audio-files/><image-files/><other-files/><text-files/><video-files/>
</action>
<action>
  <icon>shield</icon>
  <name>Open in SHIELD</name>
  <unique-id>shield-open-3</unique-id>
  <command>shield-gui --open %f</command>
  <description>Open a container (any file name)</description>
  <patterns>*</patterns>
  <audio-files/><image-files/><other-files/><text-files/><video-files/>
</action>
<action>
  <icon>shield</icon>
  <name>Secure delete with SHIELD</name>
  <unique-id>shield-wipe-3</unique-id>
  <command>shield-gui --wipe %F</command>
  <description>Opens Shield; it asks three confirmations before overwriting anything</description>
  <patterns>*</patterns>
  <directories/><audio-files/><image-files/><other-files/><text-files/><video-files/>
</action>
